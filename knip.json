{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-lintignore"],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "ignoreWorkspaces": ["legacy/packages/icons"],
  "workspaces": {
    "legacy/packages/*": {
      "entry": ["src/index.{js,jsx,ts,tsx}",""],
      "project": [
        "src/**/*.{js,jsx,ts,tsx}",
        "tests/**/*.{mjs,mts,js,jsx,ts,tsx}"
      ]
    },
    "legacy/packages/styleguide": {
      "entry": ["src/{lib,chart}.ts"],
      "project": [
        "src/**/*.{js,jsx,ts,tsx}",
        "tests/**/*.{mjs,mts,js,jsx,ts,tsx}"
      ]
    },
    "legacy/dynamic-components/*": {
      "project": [
        "src/**/*.{js,jsx,ts,tsx}",
        "test/**/*.{mjs,mts,js,jsx,ts,tsx}"
      ]
    }
  }
}
