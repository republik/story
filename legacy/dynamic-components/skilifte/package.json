    "d3-time-format": "^2.1.1",
    "dotenv": "^6.0.0",
    "downshift": "^2.0.0",
    "express": "^4.16.3",
    "file-loader": "^1.1.11",
    "glamor": "^2.20.40",
    "gsheets": "^2.0.0",
    "@republik/mdast-react-render": "workspace:*",
    "next": "^6.0.3",
    "raw-loader": "^0.5.1",
