    "@babel/preset-env": "^7.0.0-beta.51",
    "@babel/preset-react": "^7.0.0-beta.51",
    "@republik/remark-preset": "workspace:*",
    "@project-r/styleguide": "workspace:*",
    "core-js": "^2.5.7",
    "d3": "^5.9.2",
    "d3-array": "^1.2.1",
    "d3-dsv": "^1.0.8",
    "d3-format": "^1.3.0",
    "d3-scale": "^2.0.0",
