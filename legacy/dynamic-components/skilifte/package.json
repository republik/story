{
  "name": "skilifte",
  "version": "0.0.0",
  "description": "custom components for the story",
  "main": "index.js",
  "scripts": {
    "dev": "rollup -c -w && node test/server.js",
    "dev:code": "rollup -c -w",
    "dev:server": "cd test && node server.js",
    "build": "rollup -c",
    "now-build": "NODE_ENV=production rollup -c && cd test && next build",
    "heroku-postbuild": "NODE_ENV=production rollup -c && cd test && next build",
    "start": "NODE_ENV=production cd test && node server.js",
    "translations": "gsheets --key=1gmANuB6heAxirrBn7mPSMD97Ro9n_RnxZSswA0RkIvY --title=de --pretty --out src/lib/translations.json",
    "deploy": "s3cmd sync --exclude '.DS_Store' --verbose --acl-public build/ s3://republik-assets/dynamic-components/skilifte/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orbiting/skilifte.git"
  },
  "author": "",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/orbiting/skilifte/issues"
  },
